      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Coins": {
        "$className": "Folder",
        "Coin": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "Size": [
              1,
              1,
              1
            ],
            "Position": [
              0,
              3,
              0
            ]
